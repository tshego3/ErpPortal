{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-all",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"-p:UseSharedCompilation=false",
				"ErpPortal\\ErpPortal.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build",
			"dependsOn": "build-erpportal-api"
		},
		{
			"label": "build-erpportal",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"-p:UseSharedCompilation=false",
				"ErpPortal\\ErpPortal.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "build-erpportal-api",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"-p:UseSharedCompilation=false",
				"ErpPortal.Api\\ErpPortal.Api.csproj"
			],
			"isBackground": false,
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		}
	]
}
